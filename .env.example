# Copy to .env and fill in your own values. Never commit .env.
# Admin login - set your own admin password here. No default is shipped.
ADMIN_PASSWORD=your-admin-password-here
# Staff view code (optional, for cleaners)
STAFF_CODE=your-staff-code-here
# WhatsApp Business Cloud API (Meta) - automatic booking messages
# Owner / business WhatsApp number (with country code, no +)
OWNER_WHATSAPP=917876520226
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE=booking_notification
# Google Gemini (optional, for smarter AI support chat)
GEMINI_API_KEY=
# Booking emails (Gmail SMTP) - see EMAIL_SETUP.md
# GMAIL_USER is the Gmail address emails are sent FROM (usually the owner's).
# GMAIL_APP_PASSWORD is a 16-character Gmail App Password, NOT your normal
# Gmail password. Never commit real values. Without these, bookings still
# work and email_status is "not_configured".
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: override the owner email that receives new-booking alerts
# (defaults to goyaldhiman00@gmail.com)
OWNER_EMAIL=goyaldhiman00@gmail.com
# Server
PORT=3000

# MongoDB Atlas (FREE M0 tier) - optional but recommended for production
# Leave empty to use local JSON files in data/ instead.
# After creating your free Atlas cluster, paste the connection string here.
# See ATLAS_SETUP.md for step-by-step setup.
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/purenest?retryWrites=true&w=majority
MONGODB_URI=
